# Copy to backend/.env and fill in. Never commit the real .env file.

# Get a free key at https://aistudio.google.com  (leave empty to run in offline mode)
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# SQLite database file (created automatically)
# DB_PATH=data/beachwell.db

# Semester calendar (placeholder: check the official CSULB academic calendar)
SEMESTER_START=2026-08-24
SEMESTER_WEEKS=17

# Pretend today is this date, so the demo video is reproducible. Remove for real use.
DEMO_TODAY=2026-10-12

# Campus Radar never shows a group smaller than this
RADAR_MIN_GROUP=10

# Let the server download Canvas feeds by URL (1) or only accept uploaded .ics files (0)
ALLOW_FEED_FETCH=1
# Extra feed hosts allowed besides *.instructure.com, comma-separated
# ALLOWED_FEED_HOSTS=
